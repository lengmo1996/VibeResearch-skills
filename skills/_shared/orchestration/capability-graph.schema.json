{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-graph.schema.json",
  "title": "Skill capability graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nodes",
    "edges",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "status",
          "activation",
          "modes"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deprecated",
              "experimental"
            ]
          },
          "activation": {
            "enum": [
              "primary",
              "supporting-only"
            ]
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "handoff",
              "dependency",
              "replacement",
              "support"
            ]
          },
          "status": {
            "enum": [
              "active",
              "proposed",
              "deprecated"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
